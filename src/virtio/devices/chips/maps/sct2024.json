      "addr": "0x02",
      "bytes": 1,
      "access": "rw",
      "reset": "0x01",
      "description": "Sideband control mirrored from LA/OE GPIOs (and editable from the dock).",
      "fields": [
        {
          "name": "OE",
          "lsb": 0,
          "msb": 0,
          "description": "1 = outputs enabled (OE asserted). When OE is unused in DT, stays 1.",
          "values": [
            { "name": "Blanked", "value": 0 },
            { "name": "Enabled", "value": 1 }
          ]
        },
        {
          "name": "LA",
          "lsb": 1,
          "msb": 1,
          "description": "Live LA pin level as the guest last drove it (1 = logical active).",
          "values": [
