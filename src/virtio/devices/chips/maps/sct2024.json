{
  "name": "SCT2024",
  "description": "Starchips SCT2024 16-channel constant-current LED driver (SPI). Serial shift register plus parallel latch — not a pointered I²C map, but the same SVD-inspired shape the dock Registers dialog expects. Matches Zephyr drivers/led/sct2024.c (16-bit MSB-first SPI word, LA latch, optional OE).",
  "registers": [
    {
      "name": "SHIFT",
      "addr": "0x00",
      "bytes": 2,
      "access": "rw",
      "reset": 0,
      "endian": "be",
      "description": "16-bit serial shift register. Each SPI write clocks a new MSB-first word in; LA copies it to LED_OUT.",
      "fields": [
        { "name": "LED15", "lsb": 15, "msb": 15, "description": "Shift bit for LED index 15." },
        { "name": "LED14", "lsb": 14, "msb": 14 },
        { "name": "LED13", "lsb": 13, "msb": 13 },
        { "name": "LED12", "lsb": 12, "msb": 12 },
        { "name": "LED11", "lsb": 11, "msb": 11 },
        { "name": "LED10", "lsb": 10, "msb": 10 },
        { "name": "LED9", "lsb": 9, "msb": 9 },
        { "name": "LED8", "lsb": 8, "msb": 8 },
        { "name": "LED7", "lsb": 7, "msb": 7 },
        { "name": "LED6", "lsb": 6, "msb": 6 },
        { "name": "LED5", "lsb": 5, "msb": 5 },
        { "name": "LED4", "lsb": 4, "msb": 4 },
        { "name": "LED3", "lsb": 3, "msb": 3 },
        { "name": "LED2", "lsb": 2, "msb": 2 },
        { "name": "LED1", "lsb": 1, "msb": 1 },
        { "name": "LED0", "lsb": 0, "msb": 0, "description": "Shift bit for LED index 0." }
      ]
    },
    {
      "name": "LED_OUT",
      "addr": "0x01",
      "bytes": 2,
      "access": "rw",
      "reset": 0,
      "endian": "be",
      "description": "Latched parallel outputs. Updated when LA is pulsed after an SPI write (or via the Registers editor).",
      "fields": [
        {
          "name": "LED15",
          "lsb": 15,
          "msb": 15,
          "values": [
            { "name": "Off", "value": 0 },
            { "name": "On", "value": 1 }
          ]
        },
        {
          "name": "LED14",
          "lsb": 14,
