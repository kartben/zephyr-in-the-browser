{
  "name": "LP5012",
  "description": "TI LP5012 4-module RGB LED driver (I²C). Matches Zephyr drivers/led/lp50xx.c register layout for the 4-module (LP5009/LP5012) chipset.",
  "registers": [
    {
      "name": "DEVICE_CONFIG0",
      "addr": "0x00",
      "bytes": 1,
      "access": "rw",
      "reset": 0,
      "description": "Chip enable.",
      "fields": [
        {
          "name": "CHIP_EN",
          "lsb": 6,
          "msb": 6,
          "description": "1 = chip enabled.",
          "values": [
            { "name": "Off", "value": 0 },
            { "name": "On", "value": 1 }
          ]
        }
      ]
    },
    {
      "name": "DEVICE_CONFIG1",
      "addr": "0x01",
      "bytes": 1,
      "access": "rw",
      "reset": 0,
      "description": "Global LED off, auto-increment, power-save, log scale.",
      "fields": [
        { "name": "LED_GLOBAL_OFF", "lsb": 0, "msb": 0, "description": "1 = all LED outputs off." },
        { "name": "MAX_CURRENT_OPT", "lsb": 1, "msb": 1 },
        { "name": "PWM_DITHERING_EN", "lsb": 2, "msb": 2 },
        { "name": "AUTO_INCR_EN", "lsb": 3, "msb": 3 },
        { "name": "POWER_SAVE_EN", "lsb": 4, "msb": 4 },
        { "name": "LOG_SCALE_EN", "lsb": 5, "msb": 5 }
      ]
    },
    {
      "name": "LED_CONFIG0",
      "addr": "0x02",
      "bytes": 1,
      "access": "rw",
      "reset": 0,
      "description": "Per-module bank-control bits (unused by the stock sample)."
    },
    {
      "name": "BANK_BRIGHTNESS",
      "addr": "0x03",
      "bytes": 1,
      "access": "rw",
      "reset": 0,
      "description": "Bank brightness when a module is in bank mode."
    },
    {
      "name": "BANK_A_COLOR",
      "addr": "0x04",
      "bytes": 1,
      "access": "rw",
      "reset": 0,
      "description": "Bank color A (red in RGB mapping)."
    },
    {
      "name": "BANK_B_COLOR",
      "addr": "0x05",
      "bytes": 1,
      "access": "rw",
      "reset": 0,
      "description": "Bank color B (green in RGB mapping)."
    },
    {
      "name": "BANK_C_COLOR",
      "addr": "0x06",
      "bytes": 1,
      "access": "rw",
      "reset": 0,
      "description": "Bank color C (blue in RGB mapping)."
    },
    {
      "name": "LED0_BRIGHTNESS",
      "addr": "0x07",
      "bytes": 1,
      "access": "rw",
      "reset": 0,
      "description": "Module 0 brightness (0…255)."
    },
    {
      "name": "LED1_BRIGHTNESS",
      "addr": "0x08",
      "bytes": 1,
      "access": "rw",
      "reset": 0,
      "description": "Module 1 brightness (0…255)."
    },
    {
      "name": "LED2_BRIGHTNESS",
      "addr": "0x09",
      "bytes": 1,
      "access": "rw",
      "reset": 0,
      "description": "Module 2 brightness (0…255)."
    },
    {
      "name": "LED3_BRIGHTNESS",
      "addr": "0x0A",
      "bytes": 1,
      "access": "rw",
      "reset": 0,
      "description": "Module 3 brightness (0…255)."
    },
    {
      "name": "OUT0_COLOR",
      "addr": "0x0B",
      "bytes": 1,
      "access": "rw",
      "reset": 0,
      "description": "Module 0 red (sample color-mapping order R,G,B)."
    },
    {
      "name": "OUT1_COLOR",
      "addr": "0x0C",
      "bytes": 1,
      "access": "rw",
      "reset": 0,
      "description": "Module 0 green."
    },
    {
      "name": "OUT2_COLOR",
      "addr": "0x0D",
      "bytes": 1,
      "access": "rw",
      "reset": 0,
      "description": "Module 0 blue."
    },
    {
      "name": "OUT3_COLOR",
      "addr": "0x0E",
      "bytes": 1,
      "access": "rw",
      "reset": 0,
      "description": "Module 1 red."
    },
    {
      "name": "OUT4_COLOR",
      "addr": "0x0F",
      "bytes": 1,
      "access": "rw",
      "reset": 0,
      "description": "Module 1 green."
    },
    {
      "name": "OUT5_COLOR",
      "addr": "0x10",
      "bytes": 1,
      "access": "rw",
      "reset": 0,
      "description": "Module 1 blue."
    },
    {
      "name": "OUT6_COLOR",
      "addr": "0x11",
      "bytes": 1,
      "access": "rw",
      "reset": 0,
      "description": "Module 2 red."
    },
    {
      "name": "OUT7_COLOR",
      "addr": "0x12",
      "bytes": 1,
      "access": "rw",
      "reset": 0,
      "description": "Module 2 green."
    },
    {
      "name": "OUT8_COLOR",
      "addr": "0x13",
      "bytes": 1,
      "access": "rw",
      "reset": 0,
      "description": "Module 2 blue."
    },
    {
      "name": "OUT9_COLOR",
      "addr": "0x14",
      "bytes": 1,
      "access": "rw",
      "reset": 0,
      "description": "Module 3 red."
    },
    {
      "name": "OUT10_COLOR",
      "addr": "0x15",
      "bytes": 1,
      "access": "rw",
      "reset": 0,
      "description": "Module 3 green."
    },
    {
      "name": "OUT11_COLOR",
      "addr": "0x16",
      "bytes": 1,
      "access": "rw",
      "reset": 0,
      "description": "Module 3 blue."
    },
    {
      "name": "RESET",
      "addr": "0x17",
      "bytes": 1,
      "access": "rw",
      "reset": 0,
      "description": "Write 0xFF to software-reset the device."
    }
  ]
}
