    {
      "name": "MODE1",
      "addr": "0x00",
      "bytes": 1,
      "access": "rw",
      "reset": 0,
      "description": "Mode register 1 — SLEEP, AI (auto-increment), RESTART.",
      "fields": [
        {
          "name": "ALLCALL",
          "lsb": 0,
          "msb": 0,
          "description": "Respond to LED All Call."
        },
        {
          "name": "SUB3",
          "lsb": 1,
          "msb": 1
        },
        {
          "name": "SUB2",
          "lsb": 2,
          "msb": 2
        },
        {
          "name": "SUB1",
          "lsb": 3,
          "msb": 3
        },
        {
          "name": "SLEEP",
          "lsb": 4,
          "msb": 4,
          "description": "1 = low power; PRE_SCALE writable."
        },
        {
          "name": "AI",
          "lsb": 5,
          "msb": 5,
          "description": "Register auto-increment.",
          "values": [
            {
              "name": "Off",
              "value": 0
            },
            {
              "name": "On",
              "value": 1
            }
          ]
        },
        {
          "name": "EXTCLK",
          "lsb": 6,
          "msb": 6
        },
        {
          "name": "RESTART",
          "lsb": 7,
          "msb": 7,
          "description": "Restart enabled outputs after SLEEP."
        }
      ]
    },
    {
      "name": "MODE2",
      "addr": "0x01",
      "bytes": 1,
      "access": "rw",
      "reset": 4,
