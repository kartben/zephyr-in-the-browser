        {
          "name": "OUTNE",
          "lsb": 0,
          "msb": 1
        },
        {
          "name": "OUTDRV",
          "lsb": 2,
          "msb": 2,
          "description": "0 = open-drain, 1 = totem-pole.",
          "values": [
            {
              "name": "Open-drain",
              "value": 0
            },
            {
              "name": "Totem-pole",
              "value": 1
            }
          ]
        },
        {
          "name": "OCH",
          "lsb": 3,
          "msb": 3,
          "description": "Outputs change on ACK when set."
        },
        {
          "name": "INVRT",
          "lsb": 4,
          "msb": 4
        }
