{
  "name": "JHD1313 backlight",
  "description": "PCA9633-style RGB backlight on the Grove JHD1313 (I²C address 0x62). Registers Zephyr's jhd,jhd1313 driver writes during init and auxdisplay_backlight_set.",
  "registers": [
    {
      "name": "MODE1",
      "addr": "0x00",
      "bytes": 1,
      "access": "rw",
      "reset": 0,
      "description": "Sleep / restart / AI control.",
      "fields": [
        {
          "name": "AI2",
          "lsb": 7,
          "msb": 7,
          "description": "Auto-increment enable."
        },
        {
          "name": "SLEEP",
          "lsb": 4,
          "msb": 4,
          "values": [
            { "name": "Normal", "value": 0 },
            { "name": "Sleep", "value": 1 }
          ]
        }
      ]
    },
    {
      "name": "MODE2",
      "addr": "0x01",
      "bytes": 1,
      "access": "rw",
      "reset": 0,
      "description": "Output logic and blink group control. Driver writes 0x05 at init.",
      "fields": [
        {
          "name": "DMBLNK",
          "lsb": 5,
          "msb": 5,
          "description": "Group control dimming vs blinking."
        },
        {
          "name": "INVRT",
          "lsb": 4,
          "msb": 4,
          "description": "Output logic state inverted."
        },
        {
          "name": "OUTDRV",
          "lsb": 2,
          "msb": 2,
          "description": "Totem-pole vs open-drain outputs."
        }
      ]
    },
    {
      "name": "PWM0_B",
      "addr": "0x02",
      "bytes": 1,
      "access": "rw",
      "reset": 0,
      "description": "Blue channel duty (Grove wiring).",
      "fields": [
        { "name": "PWM", "lsb": 0, "msb": 7, "description": "0 = off, 255 = full." }
      ]
    },
    {
      "name": "PWM1_G",
      "addr": "0x03",
      "bytes": 1,
      "access": "rw",
      "reset": 0,
      "description": "Green channel duty (Grove wiring).",
      "fields": [
        { "name": "PWM", "lsb": 0, "msb": 7 }
      ]
    },
    {
      "name": "PWM2_R",
      "addr": "0x04",
      "bytes": 1,
      "access": "rw",
      "reset": 0,
      "description": "Red channel duty (Grove wiring).",
      "fields": [
        { "name": "PWM", "lsb": 0, "msb": 7 }
      ]
    },
    {
      "name": "GRPPWM",
      "addr": "0x05",
      "bytes": 1,
      "access": "rw",
      "reset": 0,
      "description": "Group duty cycle."
    },
    {
      "name": "GRPFREQ",
      "addr": "0x06",
      "bytes": 1,
      "access": "rw",
      "reset": 0,
      "description": "Group blinking period."
    },
    {
      "name": "LEDOUT",
      "addr": "0x08",
      "bytes": 1,
      "access": "rw",
      "reset": 0,
      "description": "Per-LED output mode. Driver writes 0xAA (PWM for LED0–3) at init.",
      "fields": [
        {
          "name": "LDR3",
          "lsb": 6,
          "msb": 7,
          "values": [
            { "name": "Off", "value": 0 },
            { "name": "On", "value": 1 },
            { "name": "PWM", "value": 2 },
            { "name": "Group", "value": 3 }
          ]
        },
        {
          "name": "LDR2",
          "lsb": 4,
          "msb": 5,
          "values": [
            { "name": "Off", "value": 0 },
            { "name": "On", "value": 1 },
            { "name": "PWM", "value": 2 },
            { "name": "Group", "value": 3 }
          ]
        },
        {
          "name": "LDR1",
          "lsb": 2,
          "msb": 3,
          "values": [
            { "name": "Off", "value": 0 },
            { "name": "On", "value": 1 },
            { "name": "PWM", "value": 2 },
            { "name": "Group", "value": 3 }
          ]
        },
        {
          "name": "LDR0",
          "lsb": 0,
          "msb": 1,
          "values": [
            { "name": "Off", "value": 0 },
            { "name": "On", "value": 1 },
            { "name": "PWM", "value": 2 },
            { "name": "Group", "value": 3 }
          ]
        }
      ]
    }
  ]
}
