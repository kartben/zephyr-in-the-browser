{
  "name": "TMP112",
  "description": "TI TMP112 digital temperature sensor register file (datasheet-oriented subset).",
  "registers": [
    {
      "name": "Temperature",
      "addr": "0x00",
      "bytes": 2,
      "access": "ro",
      "reset": 0,
      "endian": "be",
      "description": "Left-justified temperature. 12-bit normally, 13-bit when EM is set; bit 0 mirrors EM.",
      "fields": [
        {
          "name": "TEMP",
          "lsb": 3,
          "msb": 15,
          "description": "Temperature counts (shift depends on EM)."
        },
        {
          "name": "EM_FLAG",
          "lsb": 0,
          "msb": 0,
          "description": "Mirrors the Configuration EM bit when extended mode is active.",
          "values": [
            { "name": "Normal", "value": 0 },
            { "name": "Extended", "value": 1 }
          ]
        }
      ]
    },
    {
      "name": "Configuration",
      "addr": "0x01",
      "bytes": 2,
      "access": "rw",
      "reset": "0x60A0",
      "endian": "be",
      "description": "Operating mode, conversion rate, fault queue, alert polarity.",
      "fields": [
        {
          "name": "OS",
          "lsb": 15,
          "msb": 15,
          "description": "One-shot conversion trigger when shut down."
        },
        {
          "name": "R",
          "lsb": 13,
          "msb": 14,
          "description": "Converter resolution (read-only on TMP112; always 12-bit / 0b11).",
          "values": [
            { "name": "9-bit", "value": 0 },
            { "name": "10-bit", "value": 1 },
            { "name": "11-bit", "value": 2 },
            { "name": "12-bit", "value": 3 }
          ]
        },
        {
          "name": "F",
          "lsb": 11,
          "msb": 12,
          "description": "Fault queue.",
          "values": [
            { "name": "1 fault", "value": 0 },
            { "name": "2 faults", "value": 1 },
            { "name": "4 faults", "value": 2 },
            { "name": "6 faults", "value": 3 }
          ]
        },
        {
          "name": "POL",
          "lsb": 10,
          "msb": 10,
          "description": "Alert polarity.",
          "values": [
            { "name": "Active low", "value": 0 },
            { "name": "Active high", "value": 1 }
          ]
        },
        {
          "name": "TM",
          "lsb": 9,
          "msb": 9,
          "description": "Thermostat mode.",
          "values": [
            { "name": "Comparator", "value": 0 },
            { "name": "Interrupt", "value": 1 }
          ]
        },
        {
          "name": "SD",
          "lsb": 8,
          "msb": 8,
          "description": "Shutdown mode.",
          "values": [
            { "name": "Continuous", "value": 0 },
            { "name": "Shutdown", "value": 1 }
          ]
        },
        {
          "name": "CR",
          "lsb": 6,
          "msb": 7,
          "description": "Conversion rate.",
          "values": [
            { "name": "0.25 Hz", "value": 0 },
            { "name": "1 Hz", "value": 1 },
            { "name": "4 Hz", "value": 2 },
            { "name": "8 Hz", "value": 3 }
          ]
        },
        {
          "name": "AL",
          "lsb": 5,
          "msb": 5,
          "description": "Alert (read-only polarity of the ALERT pin state)."
        },
        {
          "name": "EM",
          "lsb": 4,
          "msb": 4,
          "description": "Extended mode (13-bit temperature).",
          "values": [
            { "name": "Normal (12-bit)", "value": 0 },
            { "name": "Extended (13-bit)", "value": 1 }
          ]
        }
      ]
    },
    {
      "name": "TLOW",
      "addr": "0x02",
      "bytes": 2,
      "access": "rw",
      "reset": 0,
      "endian": "be",
      "description": "Low temperature limit (same encoding as Temperature)."
    },
    {
      "name": "THIGH",
      "addr": "0x03",
      "bytes": 2,
      "access": "rw",
      "reset": 0,
      "endian": "be",
      "description": "High temperature limit (same encoding as Temperature)."
    }
  ]
}
