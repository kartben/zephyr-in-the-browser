{
  "name": "zephyr-in-the-browser-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "WebSocket uber bridge: serial CTF, optional GDB, and optional passt networking for Zephyr in the Browser",
  "type": "module",
  "main": "server.mjs",
  "bin": {
    "zephyr-bridge": "./cli.mjs"
  },
  "scripts": {
    "start": "node cli.mjs",
    "test": "node --test server.test.mjs protocol.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "serialport": "^13.0.0",
    "ws": "^8.18.0"
  }
}
