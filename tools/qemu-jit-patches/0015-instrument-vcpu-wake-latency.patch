+/*
+ * Diagnostic hook (hw/virtio/virtio-browser.c): closes the loop on how long a
+ * browser-triggered virtio_notify() takes to actually resume a vCPU thread,
+ * against how long QEMU took to notice the completion in the first place.
+ *
+ * Hooked here rather than in an accel's thread function because every one of
+ * them funnels through this: rr calls it per-CPU out of rr_wait_io_event(),
+ * mttcg and the hardware accels out of qemu_wait_io_event(). The first
+ * version of this patch hooked rr_cpu_thread_fn and silently stopped
+ * measuring anything the day the A53 dropped -icount, since that made MTTCG
+ * eligible and moved the vCPU onto a thread function the hook was not in --
+ * a dead instrument reads exactly like a fast one.
+ *
+ * Called with the BQL held on every path, which is what lets virtio-browser.c
+ * keep its counters in plain statics. Declared here rather than in a header
+ * for the same reason virtio-browser.c's own exports are: nothing else in
+ * QEMU calls it. It does mean this file needs CONFIG_VIRTIO_BROWSER, which
+ * every configuration this project builds has.
+ */
+extern void virtio_browser_note_vcpu_wake(void);
+
 void qemu_wait_io_event_common(CPUState *cpu)
 {
+    virtio_browser_note_vcpu_wake();
     qatomic_set_mb(&cpu->thread_kicked, false);
     if (cpu->stop) {
         qemu_cpu_stop(cpu, false);
diff --git a/hw/virtio/virtio-browser.c b/hw/virtio/virtio-browser.c
index 7e18656..99f4c73 100644
--- a/hw/virtio/virtio-browser.c
+++ b/hw/virtio/virtio-browser.c
@@ -206,6 +206,69 @@ static void virtio_browser_drain(void *opaque);
 static void virtio_browser_kick_bh_cb(void *opaque);
 static void virtio_browser_arm_drain(VirtIOBrowser *b);
 
+/*
+ * Diagnostic only: how long between virtio_notify() raising the guest's IRQ
+ * (recorded here, under the BQL, every time a completion is delivered) and a
+ * vCPU thread actually resuming execution (recorded by
+ * virtio_browser_note_vcpu_wake(), called from qemu_wait_io_event_common() in
+ * system/cpus.c, which every accel's thread function funnels through). Both
+ * sides run under the BQL, so plain statics are fine -- no atomics needed.
+ * wake_pending guards against counting a resume that was not preceded by a
+ * fresh notify (ordinary scheduling, kick-timer wakeups, etc).
+ *
+ * This sits inside what the round-trip counters below have to call guest
+ * time: virtio_browser_note_roundtrip() stops when QEMU drains a completion,
+ * which is before the IRQ and long before the guest's ISR runs. Without this
+ * pair, "guest + TCG" silently includes however long the host took to
+ * reschedule a halted vCPU. See docs/performance.md item 15.
+ */
+static int64_t wake_notify_ns;
+static bool wake_pending;
+static int64_t wake_latency_sum_ns;
+static int64_t wake_latency_max_ns;
+static uint32_t wake_latency_count;
+
+static void virtio_browser_note_notify(void)
+{
+    wake_notify_ns = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+    wake_pending = true;
+}
+
+void virtio_browser_note_vcpu_wake(void);
+void virtio_browser_note_vcpu_wake(void)
+{
+    int64_t latency;
+
+    if (!wake_pending) {
+        return;
+    }
+    wake_pending = false;
+    latency = qemu_clock_get_ns(QEMU_CLOCK_REALTIME) - wake_notify_ns;
+    wake_latency_sum_ns += latency;
+    wake_latency_count++;
+    if (latency > wake_latency_max_ns) {
+        wake_latency_max_ns = latency;
+    }
+}
+
+EMSCRIPTEN_KEEPALIVE
+double qemu_virtio_wake_avg_ns(void)
+{
+    return wake_latency_count ? (double)wake_latency_sum_ns / wake_latency_count : -1;
+}
+
+EMSCRIPTEN_KEEPALIVE
+double qemu_virtio_wake_max_ns(void)
+{
+    return (double)wake_latency_max_ns;
+}
+
+EMSCRIPTEN_KEEPALIVE
+uint32_t qemu_virtio_wake_count(void)
+{
+    return wake_latency_count;
+}
+
 EMSCRIPTEN_KEEPALIVE
 uint32_t qemu_virtio_browser_count(void)
 {
@@ -575,6 +638,7 @@ static void virtio_browser_drain(void *opaque)
     if (notified) {
         for (uint16_t q = 0; q < b->num_queues; q++) {
             if (notified & (1u << q)) {
+                virtio_browser_note_notify();
                 virtio_notify(vdev, b->vq[q]);
             }
         }
