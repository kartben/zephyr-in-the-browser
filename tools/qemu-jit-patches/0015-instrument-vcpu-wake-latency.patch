+ * Declared here rather than in a header for the same reason
+ * virtio-browser.c's own exports are: nothing else in QEMU calls it.
+ */
+extern void virtio_browser_note_vcpu_wake(void);
+
 /* Kick all RR vCPUs */
 void rr_kick_vcpu_thread(CPUState *unused)
 {
