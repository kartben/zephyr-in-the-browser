diff --git a/include/chardev/char-browser.h b/include/chardev/char-browser.h
new file mode 100644
index 0000000..698e069
--- /dev/null
+++ b/include/chardev/char-browser.h
@@ -0,0 +1,23 @@
+/*
+ * Browser-backed character device: the entry points page JavaScript calls.
+ *
+ * Declared in a header only because QEMU builds with -Wmissing-prototypes;
+ * nothing inside QEMU calls any of these. See chardev/char-browser.c.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef CHARDEV_CHAR_BROWSER_H
+#define CHARDEV_CHAR_BROWSER_H
+
+/** Queue one byte from the page towards the character frontend. */
+int qemu_browser_monitor_feed(int value);
+
+/** The output ring: base pointer, size, and its free-running indices. */
+void *qemu_browser_monitor_ring(void);
+int qemu_browser_monitor_ring_size(void);
+unsigned int qemu_browser_monitor_write_index(void);
+unsigned int qemu_browser_monitor_read_index(void);
+void qemu_browser_monitor_set_read_index(unsigned int value);
+
+#endif /* CHARDEV_CHAR_BROWSER_H */
