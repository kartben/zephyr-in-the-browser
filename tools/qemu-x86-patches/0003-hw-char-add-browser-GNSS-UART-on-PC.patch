+        qdev_prop_set_chr(dev, "chardev", qemu_browser_gnss_chardev());
+        isa_realize_and_unref(isadev, isa_bus, &error_fatal);
+    }
+    serial_hds_isa_init(isa_bus, 2, MAX_ISA_SERIAL_PORTS);
     parallel_hds_isa_init(isa_bus, MAX_PARALLEL_PORTS);
 
