# Samples packaged for the browser, one per line:
#
#   board:app_id:zephyr_sample_path[:conf,conf,...[:snippet,snippet,...]]
#
# - board            Zephyr board target (west build -b ...)
# - app_id           artifact basename -> public/qemu/zephyr/<board>/<app_id>.elf
#                    Must match a sample id listed for the board in src/boards.ts.
# - zephyr_sample_path  relative to the zephyr/ tree, or one of this repo's own
#                    apps when it starts with "zephyr-module/"
# - conf             optional Kconfig fragments, relative to zephyr-module/,
#                    comma-separated
# - snippet          optional snippets (west build -S ...), comma-separated.
#                    zephyr-module/snippets/ supplies virtio-gpu, virtio-gpio,
#                    virtio-i2c, virtio-spi, gpio-buzzer, i2c-sensors-extra, eeprom-only,
#                    jhd1313-only, ht16k33-only, pca9685-only, mcp4725-only,
#                    max17048-only, lp5562-only, and the *-only
#                    sensor / RTC snippets; leave the conf field empty
#                    (a bare "::") to use snippets without fragments.
#
# Every build also applies the browser_bridge shield (zephyr-module/boards/
# shields/browser_bridge), which adds the browser-fed peripherals and their
# aliases (accel0, temp0, ...). Rebuild everything with:
#
#   tools/build-zephyr-image.sh
#
# Cortex-M3 runs on qemu-wasm's TCI interpreter. Most samples run — including
# single-threaded sleepers like blinky and basic_button, though their timing is
# not wall-clock accurate — but a few multi-threaded ones (philosophers,
# synchronization) stall. Cortex-A53 uses the wasm JIT and has no such limit.
# qemu_riscv32 uses TCI on RISC-V virt with the same virtio bridges as A53
# (tools/qemu-riscv-patches/); build it with
# `tools/build-qemu-wasm.sh riscv32-softmmu`.
#
# Networking samples talk to the browser page, which implements the whole
# LAN behind the QEMU "browser" netdev: it answers as gateway/DHCP/SNTP
# (192.0.2.2), DNS (192.0.2.3), and every remote host at once. conf/net.conf
# keeps the guests IPv4-only and on the Ethernet (not SLIP) QEMU path.

qemu_cortex_m3:gnss:samples/drivers/gnss
qemu_cortex_m3:shell:samples/subsys/shell/shell_module:conf/host-gpio.conf,conf/host-audio.conf
qemu_cortex_m3:hsm:samples/subsys/smf/hsm_psicc2
qemu_cortex_m3:dhcp:samples/net/dhcpv4_client:conf/net.conf
qemu_cortex_m3:http_server:samples/net/sockets/dumb_http_server:conf/net.conf
qemu_cortex_m3:http_get:samples/net/sockets/http_get:conf/net.conf
qemu_cortex_m3:hello_world:samples/hello_world
qemu_cortex_m3:blinky:samples/basic/blinky
qemu_cortex_m3:basic_button:samples/basic/button
qemu_cortex_m3:buzzer:samples/drivers/buzzer/tone:conf/buzzer.conf:gpio-buzzer

qemu_cortex_a53:gnss:samples/drivers/gnss
qemu_cortex_a53:display:samples/drivers/display
qemu_cortex_a53:touch:samples/subsys/input/draw_touch_events
qemu_cortex_a53:lvgl_music:samples/modules/lvgl/demos:conf/lvgl-music.conf,conf/touch.conf
qemu_cortex_a53:accel_chart:zephyr-module/apps/accelerometer_chart:conf/lvgl-accel.conf:virtio-i2c,accel-display
qemu_cortex_a53:lsm6dso:samples/sensor/lsm6dso:conf/lsm6dso.conf:virtio-i2c,lsm6dso-only
qemu_cortex_a53:lps22hh:samples/sensor/lps22hh:conf/lps22hh.conf:virtio-i2c,lps22hh-only
qemu_cortex_a53:ina219:samples/sensor/ina219:conf/ina219.conf:virtio-i2c,ina219-only
qemu_cortex_a53:isl29035:samples/sensor/isl29035:conf/isl29035.conf:virtio-i2c,isl29035-only
qemu_cortex_a53:eeprom:samples/drivers/eeprom:conf/eeprom.conf:virtio-i2c,eeprom-only
qemu_cortex_a53:spi_flash:samples/drivers/spi_flash:conf/spi-flash.conf:virtio-spi
qemu_cortex_a53:rtc:samples/drivers/rtc:conf/pcf8523.conf:virtio-i2c,pcf8523-only
qemu_cortex_a53:auxdisplay:samples/drivers/auxdisplay:conf/jhd1313.conf:virtio-i2c,jhd1313-only
qemu_cortex_a53:ht16k33:samples/drivers/ht16k33:conf/ht16k33.conf:virtio-i2c,ht16k33-only
qemu_cortex_a53:lp5562:samples/drivers/led/lp5562:conf/lp5562.conf:virtio-i2c,lp5562-only
qemu_cortex_a53:pwm_led:samples/drivers/led/pwm:conf/pca9685.conf:virtio-i2c,pca9685-only
qemu_cortex_a53:dac:samples/drivers/dac:conf/mcp4725.conf:virtio-i2c,mcp4725-only
qemu_cortex_a53:fuel_gauge:samples/drivers/fuel_gauge:conf/max17048.conf:virtio-i2c,max17048-only
qemu_cortex_a53:philosophers:samples/philosophers
qemu_cortex_a53:tracing:samples/subsys/tracing/basic
qemu_cortex_a53:blinky:samples/basic/blinky::virtio-gpio
qemu_cortex_a53:basic_button:samples/basic/button::virtio-gpio
qemu_cortex_a53:buzzer:samples/drivers/buzzer/tone:conf/buzzer.conf:virtio-gpio,gpio-buzzer
qemu_cortex_a53:shell:samples/subsys/shell/shell_module:conf/boot-banner.conf,conf/host-audio.conf,conf/host-mic.conf,conf/i2c.conf:virtio-i2c,i2c-sensors-extra
qemu_cortex_a53:oled:samples/drivers/display::virtio-i2c,oled
qemu_cortex_a53:hsm:samples/subsys/smf/hsm_psicc2
qemu_cortex_a53:dhcp:samples/net/dhcpv4_client:conf/net.conf
qemu_cortex_a53:http_server:samples/net/sockets/dumb_http_server:conf/net.conf
qemu_cortex_a53:echo_server:samples/net/sockets/echo_server:conf/net.conf
qemu_cortex_a53:http_get:samples/net/sockets/http_get:conf/net.conf
qemu_cortex_a53:zperf:samples/net/zperf:conf/net.conf
qemu_cortex_a53:hello_world:samples/hello_world

# RISC-V 32-bit virt: same virtio / browser-bridge shape as A53. Built with
# tools/build-qemu-wasm.sh riscv32-softmmu (TCI). Tracing is omitted — that
# sample rides ARM semihosting on A53.
qemu_riscv32:gnss:samples/drivers/gnss
qemu_riscv32:display:samples/drivers/display
qemu_riscv32:touch:samples/subsys/input/draw_touch_events
qemu_riscv32:lvgl_music:samples/modules/lvgl/demos:conf/lvgl-music.conf,conf/touch.conf
qemu_riscv32:accel_chart:zephyr-module/apps/accelerometer_chart:conf/lvgl-accel.conf:virtio-i2c,accel-display
qemu_riscv32:lsm6dso:samples/sensor/lsm6dso:conf/lsm6dso.conf:virtio-i2c,lsm6dso-only
qemu_riscv32:lps22hh:samples/sensor/lps22hh:conf/lps22hh.conf:virtio-i2c,lps22hh-only
qemu_riscv32:ina219:samples/sensor/ina219:conf/ina219.conf:virtio-i2c,ina219-only
qemu_riscv32:isl29035:samples/sensor/isl29035:conf/isl29035.conf:virtio-i2c,isl29035-only
qemu_riscv32:eeprom:samples/drivers/eeprom:conf/eeprom.conf:virtio-i2c,eeprom-only
qemu_riscv32:spi_flash:samples/drivers/spi_flash:conf/spi-flash.conf:virtio-spi
qemu_riscv32:rtc:samples/drivers/rtc:conf/pcf8523.conf:virtio-i2c,pcf8523-only
qemu_riscv32:auxdisplay:samples/drivers/auxdisplay:conf/jhd1313.conf:virtio-i2c,jhd1313-only
qemu_riscv32:ht16k33:samples/drivers/ht16k33:conf/ht16k33.conf:virtio-i2c,ht16k33-only
qemu_riscv32:lp5562:samples/drivers/led/lp5562:conf/lp5562.conf:virtio-i2c,lp5562-only
qemu_riscv32:pwm_led:samples/drivers/led/pwm:conf/pca9685.conf:virtio-i2c,pca9685-only
qemu_riscv32:dac:samples/drivers/dac:conf/mcp4725.conf:virtio-i2c,mcp4725-only
qemu_riscv32:fuel_gauge:samples/drivers/fuel_gauge:conf/max17048.conf:virtio-i2c,max17048-only
qemu_riscv32:philosophers:samples/philosophers
qemu_riscv32:blinky:samples/basic/blinky::virtio-gpio
qemu_riscv32:basic_button:samples/basic/button::virtio-gpio
qemu_riscv32:buzzer:samples/drivers/buzzer/tone:conf/buzzer.conf:virtio-gpio,gpio-buzzer
qemu_riscv32:shell:samples/subsys/shell/shell_module:conf/boot-banner.conf,conf/host-audio.conf,conf/host-mic.conf,conf/i2c.conf:virtio-i2c,i2c-sensors-extra
