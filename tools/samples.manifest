qemu_riscv32:hsm:samples/subsys/smf/hsm_psicc2
qemu_riscv32:dhcp:samples/net/dhcpv4_client:conf/net.conf
qemu_riscv32:http_server:samples/net/sockets/dumb_http_server:conf/net.conf
