+     * held. The word is a file-static, not a field, because it can arrive
+     * before this device exists. See qemu_host_gpio_set_inputs() in
+     * hw/gpio/esp32_gpio.c. */
     QEMUTimer *bridge_timer;
 } Esp32GpioState;
 
