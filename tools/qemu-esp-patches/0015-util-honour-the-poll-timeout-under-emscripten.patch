diff --git a/hw/virtio/virtio-browser.c b/hw/virtio/virtio-browser.c
index 7e18656..2451c2e 100644
--- a/hw/virtio/virtio-browser.c
+++ b/hw/virtio/virtio-browser.c
@@ -191,6 +191,13 @@ uintptr_t qemu_virtio_browser_wake_addr(void);
 uintptr_t qemu_virtio_browser_request_wake_addr(void);
 void qemu_virtio_browser_kick(void);
 
+/*
+ * Lets QEMU's main loop wait on virtio_browser_wake while polling instead of
+ * spinning; see the comment on the wait in util/main-loop.c. Declared here
+ * rather than in a header for the same reason as the exports above.
+ */
+void qemu_set_browser_poll_wake_word(uint32_t *word);
+
 /*
  * Futex word the page Atomics.notify-s after publishing cmp_wr. kick() also
  * futex-wakes it and schedules a BH to drain on the QEMU main loop (BQL held).
@@ -776,6 +783,9 @@ static void virtio_browser_device_realize(DeviceState *dev, Error **errp)
         virtio_browser_kick_bh = qemu_bh_new(virtio_browser_kick_bh_cb, NULL);
     }
 
+#ifdef __EMSCRIPTEN__
+    qemu_set_browser_poll_wake_word(&virtio_browser_wake);
+#endif
     b->drain = timer_new_ms(QEMU_CLOCK_REALTIME, virtio_browser_drain, b);
     timer_mod(b->drain, qemu_clock_get_ms(QEMU_CLOCK_REALTIME) +
                             VIRTIO_BROWSER_DRAIN_IDLE_MS);
diff --git a/util/main-loop.c b/util/main-loop.c
index 51aeb24..c83f93e 100644
--- a/util/main-loop.c
+++ b/util/main-loop.c
@@ -23,6 +23,10 @@
  */
 
 #include "qemu/osdep.h"
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+#include <emscripten/threading.h>
+#endif
 #include "qapi/error.h"
 #include "qemu/cutils.h"
 #include "qemu/timer.h"
@@ -290,6 +294,23 @@ static void glib_pollfds_poll(void)
 
 #define MAX_MAIN_LOOP_SPIN (1000)
 
+#ifdef __EMSCRIPTEN__
+/*
+ * Registered by hw/virtio/virtio-browser.c when it realizes, and left NULL in a
+ * build without that device: the ESP32 machines enable no VIRTIO, so it is not
+ * even compiled for xtensa-softmmu. A hook rather than a direct call because
+ * util/ is built once for every target and cannot reference a device symbol
+ * that may not be linked. See the wait in os_host_main_loop_wait().
+ */
+static uint32_t *browser_poll_wake_word;
+
+void qemu_set_browser_poll_wake_word(uint32_t *word);
+void qemu_set_browser_poll_wake_word(uint32_t *word)
+{
+    browser_poll_wake_word = word;
+}
+#endif
+
 static int os_host_main_loop_wait(int64_t timeout)
 {
     GMainContext *context = g_main_context_default();
@@ -304,6 +325,48 @@ static int os_host_main_loop_wait(int64_t timeout)
 
     ret = qemu_poll_ns((GPollFD *)gpollfds->data, gpollfds->len, timeout);
 
+#ifdef __EMSCRIPTEN__
+    /*
+     * Emscripten implements poll() as a readiness scan that ignores its
+     * timeout and returns immediately, and under -sPROXY_TO_PTHREAD that scan
+     * is a *synchronous* proxied call to the browser main thread. So this loop
+     * spins, and every turn of it is a blocking round trip to the thread that
+     * is also trying to render: measured on the A53 display machine at 83k
+     * iterations/s, matched 1:1 by proxied poll calls.
+     *
+     * Wait out the timeout the loop already asked for instead. Where there is a
+     * virtio-browser device, wait on its completion futex, which
+     * qemu_virtio_browser_kick() already increments and futex-wakes and which
+     * nothing waited on before, so a page-side completion cuts the wait short
+     * rather than paying for it. Without one, sleep plainly.
+     *
+     * The 0.25 ms cap is measured, not chosen for looking round. This wait is
+     * interruptible only by that futex: qemu_notify_event() reaches the loop
+     * through an fd only the next poll looks at. At a 1 ms cap the wait
+     * swallows kicked completions and costs a third of the guest's
+     * blocking-transfer throughput (496 -> 331 completions/s on the stock
+     * 7-segment multiplex). At 0.25 ms throughput is unchanged (500/s) and the
+     * proxied traffic is still down 93%, from 84.7k to 5.7k calls/s.
+     *
+     * Deliberately inside the bql_unlock() window: waiting while holding the
+     * BQL would stall the vCPU thread, which is the opposite of the point.
+     */
+    if (ret == 0 && timeout > 0) {
+        double browser_poll_sleep = timeout / 1000000.0;
+
+        if (browser_poll_sleep > 0.25) {
+            browser_poll_sleep = 0.25;
+        }
+        if (browser_poll_wake_word) {
+            emscripten_futex_wait(browser_poll_wake_word,
+                                  qatomic_read(browser_poll_wake_word),
+                                  browser_poll_sleep);
+        } else {
+            emscripten_thread_sleep(browser_poll_sleep);
+        }
+    }
+#endif
+
     replay_mutex_lock();
     bql_lock();
 
