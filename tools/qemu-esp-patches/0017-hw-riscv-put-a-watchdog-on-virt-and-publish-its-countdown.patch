+/*
+ * One stage: the count reaching WDOGCMP0 resets the part when RSTEN is set,
+ * and otherwise only raises IP0.
+ */
+static void sifive_e_aon_wdt_status(void *opaque, BrowserWdtState *st)
+{
+    SiFiveEAONState *r = opaque;
+    const unsigned scale = FIELD_EX32(r->wdogcfg, AON_WDT_WDOGCFG, SCALE);
+    const int64_t expires = timer_expire_time_ns(r->wdog_timer);
+
+    st->enabled = FIELD_EX32(r->wdogcfg, AON_WDT_WDOGCFG, EN_ALWAYS) ||
+                  FIELD_EX32(r->wdogcfg, AON_WDT_WDOGCFG, EN_CORE_AWAKE);
+    st->stage = 0;
+    st->action[0] = FIELD_EX32(r->wdogcfg, AON_WDT_WDOGCFG, RSTEN)
+                    ? BROWSER_WDT_RESET_SYSTEM : BROWSER_WDT_INTERRUPT;
+    st->action[1] = st->action[2] = st->action[3] = BROWSER_WDT_OFF;
+    st->freq_hz = r->wdogclk_freq >> scale;
+    st->stage_ticks[0] = r->wdogcmp0;
+    st->stage_ticks[1] = st->stage_ticks[2] = st->stage_ticks[3] = 0;
+    st->deadline_ns = expires > 0 && expires != INT64_MAX ? expires : 0;
+}
+
+static void sifive_e_aon_wdt_publish(SiFiveEAONState *r, bool bite)
