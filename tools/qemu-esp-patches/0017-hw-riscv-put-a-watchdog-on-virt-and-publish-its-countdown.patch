diff --git a/hw/watchdog/browser-wdt-status.c b/hw/watchdog/browser-wdt-status.c
new file mode 100644
index 0000000..90c5e1d
--- /dev/null
+++ b/hw/watchdog/browser-wdt-status.c
@@ -0,0 +1,190 @@
+/*
+ * Watchdog status block for the browser's device dock
+ *
+ * A running watchdog is invisible. The guest prints "Feeding watchdog..." and
+ * some time later the part reboots, with nothing in between to say how close
+ * it came, and afterwards the boot banner looks like any other. This keeps
+ * what the page needs to show both: the stage, its deadline and the clock it
+ * is measured against, and counts of feeds, interrupts and bites.
+ *
+ * The page reads it from the browser's main thread while QEMU writes, and the
+ * fields go together, so each slot has a seqlock: `seq` is odd while a write
+ * is in progress and a reader retries if it moved.
+ *
+ * The page also has no guest clock of its own, and under -icount the guest's
+ * time is not the wall's. So while a watchdog runs, a QEMU_CLOCK_VIRTUAL
+ * timer republishes `now` every 20 ms, and the countdown is measured against
+ * that.
+ *
+ * Bites survive the reset they cause, since that is when they matter.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/atomic.h"
+#include "qemu/timer.h"
+#include "hw/watchdog/browser-wdt-status.h"
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+#endif
+
+#define STATUS_MAGIC     0x53544457u /* "WDTS" */
+#define STATUS_VERSION   1
+#define STATUS_SLOTS     4
+#define STATUS_PERIOD_NS (20 * SCALE_MS)
+
+/* Must match src/hostWatchdog.ts */
+typedef struct BrowserWdtSlot {
+    uint32_t seq;
+    uint32_t present;
+    uint32_t index;
+    uint32_t enabled;
+    uint32_t stage;
+    uint32_t actions;
+    uint32_t freq_hz;
+    uint32_t stage_ticks[BROWSER_WDT_STAGES];
+    uint32_t feeds;
+    uint32_t interrupts;
+    uint32_t bites;
+    uint32_t bite_action;
+    uint32_t bite_stage;
+    uint32_t deadline_lo, deadline_hi;
+    uint32_t now_lo, now_hi;
+    uint32_t bite_lo, bite_hi;
+} BrowserWdtSlot;
+
+typedef struct BrowserWdtStatus {
+    uint32_t magic;
+    uint32_t version;
+    uint32_t slot_count;
+    uint32_t slot_size;
+    BrowserWdtSlot slot[STATUS_SLOTS];
+} BrowserWdtStatus;
+
+static BrowserWdtStatus status = {
+    .magic = STATUS_MAGIC,
+    .version = STATUS_VERSION,
+    .slot_count = STATUS_SLOTS,
+    .slot_size = sizeof(BrowserWdtSlot),
+};
+
+typedef struct Heartbeat {
+    QEMUTimer *timer;
+    BrowserWdtRefresh refresh;
+    void *opaque;
+    int slot;
+} Heartbeat;
+
+static Heartbeat heartbeats[STATUS_SLOTS];
+static int claimed;
+
+#ifdef __EMSCRIPTEN__
+EMSCRIPTEN_KEEPALIVE
+uint32_t qemu_browser_wdt_status(void)
+{
+    return (uint32_t)(uintptr_t)&status;
+}
+#endif
+
+static void split(uint32_t *lo, uint32_t *hi, int64_t v)
+{
+    *lo = (uint32_t)v;
+    *hi = (uint32_t)((uint64_t)v >> 32);
+}
+
+static void heartbeat_cb(void *opaque)
+{
+    Heartbeat *hb = opaque;
+    BrowserWdtState st = { 0 };
+
+    if (!hb->refresh) {
+        return;
+    }
+    hb->refresh(hb->opaque, &st);
+    browser_wdt_publish(hb->slot, &st, false);
+}
+
+int browser_wdt_claim(void)
+{
+    if (claimed >= STATUS_SLOTS) {
+        return -1;
+    }
+    const int n = claimed++;
+    status.slot[n].present = 1;
+    status.slot[n].index = n;
+    heartbeats[n].slot = n;
+    heartbeats[n].timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, heartbeat_cb, &heartbeats[n]);
+    return n;
+}
+
+void browser_wdt_set_refresh(int slot, BrowserWdtRefresh refresh, void *opaque)
+{
+    if (slot < 0) {
+        return;
+    }
+    heartbeats[slot].refresh = refresh;
+    heartbeats[slot].opaque = opaque;
+}
+
+void browser_wdt_publish(int slot, const BrowserWdtState *st, bool bite)
+{
+    if (slot < 0) {
+        return;
+    }
+    BrowserWdtSlot *s = &status.slot[slot];
+    const int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    qatomic_set(&s->seq, s->seq + 1);
+    smp_wmb();
+
+    s->enabled = st->enabled;
+    s->stage = st->stage;
+    s->actions = 0;
+    for (int i = 0; i < BROWSER_WDT_STAGES; i++) {
+        s->actions |= (st->action[i] & 3) << (2 * i);
+        s->stage_ticks[i] = st->stage_ticks[i];
+    }
+    s->freq_hz = st->freq_hz;
+    split(&s->deadline_lo, &s->deadline_hi, st->enabled ? st->deadline_ns : 0);
+    split(&s->now_lo, &s->now_hi, now);
+    if (bite) {
+        s->bites++;
+        s->bite_action = st->action[st->stage < BROWSER_WDT_STAGES ? st->stage : 0];
+        s->bite_stage = st->stage;
+        split(&s->bite_lo, &s->bite_hi, now);
+    }
+
+    smp_wmb();
+    qatomic_set(&s->seq, s->seq + 1);
+
+    QEMUTimer *t = heartbeats[slot].timer;
+    if (t) {
+        if (st->enabled && !bite) {
+            timer_mod_ns(t, now + STATUS_PERIOD_NS);
+        } else {
+            timer_del(t);
+        }
+    }
+}
+
+void browser_wdt_count_feed(int slot)
+{
+    if (slot >= 0) {
+        status.slot[slot].feeds++;
+    }
+}
+
+void browser_wdt_count_interrupt(int slot)
+{
+    if (slot >= 0) {
+        status.slot[slot].interrupts++;
+    }
+}
+
+void browser_wdt_reset_feeds(int slot)
+{
+    if (slot >= 0) {
+        status.slot[slot].feeds = 0;
+    }
+}
