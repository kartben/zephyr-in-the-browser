diff --git a/include/hw/watchdog/browser-wdt-status.h b/include/hw/watchdog/browser-wdt-status.h
new file mode 100644
index 0000000..e85dd47
--- /dev/null
+++ b/include/hw/watchdog/browser-wdt-status.h
@@ -0,0 +1,59 @@
+/*
+ * Watchdog status block for the browser's device dock
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_WATCHDOG_BROWSER_WDT_STATUS_H
+#define HW_WATCHDOG_BROWSER_WDT_STATUS_H
+
+#include "qemu/timer.h"
+
+/*
+ * What a watchdog model publishes so the page can draw its countdown and say
+ * afterwards why the part reset. The layout is the ESP32 timer group's
+ * (hw/timer/esp_timg.c in the ESP32 tree) so one reader, src/hostWatchdog.ts,
+ * serves both; only the exported function's name differs.
+ *
+ * Stages are the model's own notion: a CMSDK watchdog interrupts on its first
+ * expiry and resets on its second, which is two stages of the same length.
+ */
+#define BROWSER_WDT_STAGES 4
+
+typedef enum {
+    BROWSER_WDT_OFF = 0,
+    BROWSER_WDT_INTERRUPT = 1,
+    BROWSER_WDT_RESET_CPU = 2,
+    BROWSER_WDT_RESET_SYSTEM = 3,
+} BrowserWdtAction;
+
+typedef struct BrowserWdtState {
+    bool enabled;
+    unsigned stage;
+    BrowserWdtAction action[BROWSER_WDT_STAGES];
+    uint32_t freq_hz;
+    uint32_t stage_ticks[BROWSER_WDT_STAGES];
+    /* QEMU_CLOCK_VIRTUAL ns when the current stage expires; 0 if not armed */
+    int64_t deadline_ns;
+} BrowserWdtState;
+
+/* Claim a slot for a watchdog; -1 once they are all taken */
+int browser_wdt_claim(void);
+
+/*
+ * Publish `st`. A bite also records the reset about to be requested. Keeps a
+ * timer republishing the clock every 20 ms of virtual time while `st` is
+ * enabled (see the .c file for why), which `refresh` fills in again.
+ */
+void browser_wdt_publish(int slot, const BrowserWdtState *st, bool bite);
+
+/* Count a feed, a stage interrupt, or clear the feeds at reset */
+void browser_wdt_count_feed(int slot);
+void browser_wdt_count_interrupt(int slot);
+void browser_wdt_reset_feeds(int slot);
+
+/* Called on the heartbeat to refetch a model's state */
+typedef void (*BrowserWdtRefresh)(void *opaque, BrowserWdtState *st);
+void browser_wdt_set_refresh(int slot, BrowserWdtRefresh refresh, void *opaque);
+
+#endif
