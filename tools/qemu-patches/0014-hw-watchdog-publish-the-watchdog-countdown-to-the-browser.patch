     return s->resetstatus && (s->control & R_WDOGCONTROL_RESEN_MASK);
 }
 
+/*
+ * The counter as two stages of the same length: the first expiry interrupts,
+ * the second resets if RESEN allows it and otherwise just stops the count.
+ */
+static void cmsdk_apb_watchdog_status(void *opaque, BrowserWdtState *st)
+{
+    CMSDKAPBWatchdog *s = opaque;
+    const bool running = (s->control & R_WDOGCONTROL_INTEN_MASK) && !s->resetstatus;
+    const uint32_t limit = ptimer_get_limit(s->timer);
+
+    st->enabled = running;
+    st->stage = s->intstatus ? 1 : 0;
+    st->action[0] = BROWSER_WDT_INTERRUPT;
+    st->action[1] = (s->control & R_WDOGCONTROL_RESEN_MASK) ? BROWSER_WDT_RESET_SYSTEM
+                                                            : BROWSER_WDT_OFF;
+    st->action[2] = st->action[3] = BROWSER_WDT_OFF;
+    st->freq_hz = clock_get_hz(s->wdogclk);
+    st->stage_ticks[0] = st->stage_ticks[1] = limit;
+    st->stage_ticks[2] = st->stage_ticks[3] = 0;
+    st->deadline_ns = running
+        ? qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+          clock_ticks_to_ns(s->wdogclk, ptimer_get_count(s->timer))
+        : 0;
+}
+
+static void cmsdk_apb_watchdog_publish(CMSDKAPBWatchdog *s, bool bite)
+{
+    BrowserWdtState st = { 0 };
+
+    if (s->status_slot < 0 || !s->timer) {
+        return;
+    }
+    cmsdk_apb_watchdog_status(s, &st);
+    if (bite) {
+        /* Report the stage that bit, not the stopped counter's */
+        st.stage = 1;
+    }
+    browser_wdt_publish(s->status_slot, &st, bite);
+}
+
