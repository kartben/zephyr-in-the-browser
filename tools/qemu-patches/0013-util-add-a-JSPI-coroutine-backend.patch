+ */
+
+#include "qemu/osdep.h"
+#include "qemu/coroutine_int.h"
+#include "qemu/coroutine-tls.h"
+
+#include <emscripten.h>
+#include <emscripten/stack.h>
+
+typedef struct {
+    Coroutine base;
+    void *stack;
+    size_t stack_size;
+    /* Shadow stack bounds, high address first, as emscripten_stack_set_limits() takes them. */
+    uintptr_t stack_base;
+    uintptr_t stack_end;
+    /* Shadow stack pointer to restore when this coroutine runs again. */
+    uintptr_t stack_ptr;
+    CoroutineAction action;
+    /* Has a WebAssembly stack: from the first entry until termination. */
+    bool started;
+} CoroutineJSPI;
+
+/**
+ * Per-thread coroutine bookkeeping
+ */
+QEMU_DEFINE_STATIC_CO_TLS(Coroutine *, current);
+QEMU_DEFINE_STATIC_CO_TLS(CoroutineJSPI *, leader);
+
+/* compiler-rt's stack_ops: sets the shadow stack pointer. */
+void _emscripten_stack_restore(uintptr_t ptr);
+
+/*
+ * The scheduler is JavaScript, one per worker: the resolve function of the
+ * promise each parked coroutine waits on, keyed by coroutine pointer. A
+ * fresh coroutine is started from a microtask so that it runs only once the
+ * caller has parked, which is also when a resolved coroutine continues.
+ */
+EM_JS(void, qemu_jspi_wake, (void *to, void *entry, int fresh), {
+    if (!Module.qemuJspiParked) {
+        if (typeof WebAssembly.promising !== 'function') {
+            abort('this build needs JavaScript Promise Integration (WebAssembly.promising)');
+        }
+        Module.qemuJspiParked = new Map();
+        Module.qemuJspiStart = WebAssembly.promising(wasmTable.get(entry));
+    }
+    if (fresh) {
+        const start = Module.qemuJspiStart;
+        queueMicrotask(() => { start(to); });
+        return;
+    }
+    const resolve = Module.qemuJspiParked.get(to);
+    if (!resolve) {
+        abort('qemu_coroutine_switch: coroutine ' + to + ' is not parked on this thread');
+    }
+    Module.qemuJspiParked.delete(to);
+    resolve();
+});
+
+EM_ASYNC_JS(void, qemu_jspi_park, (void *self), {
+    await new Promise((resolve) => { Module.qemuJspiParked.set(self, resolve); });
+});
+
+static void coroutine_trampoline(Coroutine *co)
+{
+    co->entry(co->entry_arg);
+    qemu_coroutine_switch(co, co->caller, COROUTINE_TERMINATE);
+    /*
+     * The switch returns without parking on termination, so this stack ends
+     * here; the caller continues once the return reaches the event loop.
+     */
+}
+
+/*
+ * Runs on a fresh WebAssembly stack, called from JavaScript. The shadow stack
+ * pointer still belongs to whichever coroutine last ran on this thread, so
+ * nothing before the restore may touch it.
+ */
+static __attribute__((noinline)) void coroutine_entry(void *co_)
+{
+    CoroutineJSPI *co = co_;
+
+    _emscripten_stack_restore(co->stack_base);
+    emscripten_stack_set_limits((void *)co->stack_base, (void *)co->stack_end);
+    coroutine_trampoline(&co->base);
+}
+
+Coroutine *qemu_coroutine_new(void)
+{
+    CoroutineJSPI *co;
+
+    co = g_malloc0(sizeof(*co));
+    co->stack_size = COROUTINE_STACK_SIZE;
+    co->stack = qemu_alloc_stack(&co->stack_size);
+    co->stack_base = (uintptr_t)co->stack + co->stack_size;
+    co->stack_end = (uintptr_t)co->stack;
+
+    return &co->base;
+}
+
+void qemu_coroutine_delete(Coroutine *co_)
+{
+    CoroutineJSPI *co = DO_UPCAST(CoroutineJSPI, base, co_);
+
+    /* Only terminated coroutines are deleted, and those hold no stack. */
+    qemu_free_stack(co->stack, co->stack_size);
+    g_free(co);
+}
+
+CoroutineAction qemu_coroutine_switch(Coroutine *from_, Coroutine *to_,
+                                      CoroutineAction action)
+{
+    CoroutineJSPI *from = DO_UPCAST(CoroutineJSPI, base, from_);
+    CoroutineJSPI *to = DO_UPCAST(CoroutineJSPI, base, to_);
+    bool fresh = !to->started;
+
+    set_current(to_);
+    to->action = action;
+    to->started = true;
+    qemu_jspi_wake(to, (void *)coroutine_entry, fresh);
+
+    if (action == COROUTINE_TERMINATE) {
+        /*
+         * Do not park: the trampoline and the entry return, the promise of
+         * this stack settles and the engine drops it. The next entry starts
+         * the coroutine on a new stack, with the same C stack.
+         */
+        from->started = false;
+        return action;
+    }
+
+    from->stack_ptr = emscripten_stack_get_current();
+    qemu_jspi_park(from);
+    _emscripten_stack_restore(from->stack_ptr);
+    emscripten_stack_set_limits((void *)from->stack_base, (void *)from->stack_end);
+    return from->action;
+}
+
+Coroutine *qemu_coroutine_self(void)
+{
+    Coroutine *self = get_current();
+
+    if (!self) {
+        CoroutineJSPI *leaderp = get_leader();
+        if (!leaderp) {
+            leaderp = g_malloc0(sizeof(*leaderp));
+            leaderp->stack_base = emscripten_stack_get_base();
+            leaderp->stack_end = emscripten_stack_get_end();
+            leaderp->started = true;
+            set_leader(leaderp);
+        }
+        self = &leaderp->base;
+        set_current(self);
+    }
+    return self;
+}
+
+bool qemu_in_coroutine(void)
+{
+    Coroutine *self = get_current();
+
+    return self && self->caller;
+}
