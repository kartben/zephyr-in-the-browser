 }
 
 /*
@@ -340,6 +356,42 @@ void qemu_browser_gdb_detach(void)
     browser_gdb->pending_close = true;
 }
 
+EMSCRIPTEN_KEEPALIVE
+int qemu_browser_hci_feed(int value)
