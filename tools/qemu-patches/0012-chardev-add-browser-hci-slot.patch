+        *be_opened = true;
+        if (browser_hci != NULL && browser_hci != s) {
+            error_setg(errp, "browser chardev id=hci0 already claimed");
+            return;
+        }
+        browser_hci = s;
     } else {
         /* Working chardev, but the page has no exports for this id. */
         *be_opened = true;
@@ -195,6 +208,9 @@ static void browser_chr_finalize(Object *obj)
     if (browser_gdb == s) {
         browser_gdb = NULL;
     }
+    if (browser_hci == s) {
