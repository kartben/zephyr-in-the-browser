@@ -41,5 +42,15 @@
  */
 int qemu_browser_gdb_attach(void);
 void qemu_browser_gdb_detach(void);
+
+/** Queue one byte from the page towards the HCI UART (id=hci0). */
+int qemu_browser_hci_feed(int value);
+
+/** The HCI output ring: base pointer, size, and its free-running indices. */
+void *qemu_browser_hci_ring(void);
+int qemu_browser_hci_ring_size(void);
+unsigned int qemu_browser_hci_write_index(void);
+unsigned int qemu_browser_hci_read_index(void);
+void qemu_browser_hci_set_read_index(unsigned int value);
 
 #endif /* CHARDEV_CHAR_BROWSER_H */
