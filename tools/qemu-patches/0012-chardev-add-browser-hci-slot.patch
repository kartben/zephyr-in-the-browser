+{
+    return browser_ring_size(browser_hci);
+}
+
+EMSCRIPTEN_KEEPALIVE
+unsigned int qemu_browser_hci_write_index(void)
+{
+    return browser_write_index(browser_hci);
+}
+
+EMSCRIPTEN_KEEPALIVE
+unsigned int qemu_browser_hci_read_index(void)
+{
+    return browser_read_index(browser_hci);
+}
+
+EMSCRIPTEN_KEEPALIVE
+void qemu_browser_hci_set_read_index(unsigned int value)
