diff --git a/hw/riscv/virt.c b/hw/riscv/virt.c
--- a/hw/riscv/virt.c
+++ b/hw/riscv/virt.c
@@ -1728,4 +1728,18 @@ static void virt_machine_init(MachineState *machine)
     qemu_browser_input_init();

+    /*
+     * Bluetooth HCI UART (H:4): third 16550 at 0x1000c000 (PLIC IRQ 13).
+     * Only realized when `-chardev browser,id=hci0` is on the command line.
+     */
+    {
+        Chardev *hci = qemu_chr_find("hci0");
+
+        if (hci) {
+            serial_mm_init(system_memory, 0x1000c000,
+                0, qdev_get_gpio_in(mmio_irqchip, 13), 399193,
+                hci, DEVICE_LITTLE_ENDIAN);
+        }
+    }
+
     sysbus_create_simple("goldfish_rtc", s->memmap[VIRT_RTC].base,
         qdev_get_gpio_in(mmio_irqchip, RTC_IRQ));
