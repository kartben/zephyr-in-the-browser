diff --git a/chardev/char-browser.c b/chardev/char-browser.c
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/chardev/char-browser.c
@@ -0,0 +1,344 @@
+/*
+ * Browser-backed character device.
+ *
+ * Exposes a chardev whose two ends live either side of the wasm boundary: page
+ * JavaScript writes bytes into an input ring and reads whatever the frontend
+ * produced out of an output ring.
+ *
+ * Two named slots are exported to the page, keyed by the chardev `id=`:
+ *
+ *   -chardev browser,id=mon0 -mon chardev=mon0,mode=control
+ *   -chardev browser,id=gdb0 -gdb chardev:gdb0
+ *
+ * `mon0` is always-open (QMP needs OPENED immediately). `gdb0` stays closed
+ * until the page calls qemu_browser_gdb_attach(), otherwise the gdbstub would
+ * treat boot as "client connected" and freeze the guest.
+ *
+ * Unknown ids still get a working Chardev (timer + rings) but no JS exports.
+ *
+ * The timer is on QEMU_CLOCK_REALTIME rather than the virtual clock, and that
+ * is load-bearing: the virtual clock stops with the machine, so a `cont` or
+ * gdb vCont typed into a paused guest would never be delivered.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/atomic.h"
+#include "qemu/module.h"
+#include "qemu/timer.h"
+#include "chardev/char.h"
+#include "chardev/char-browser.h"
+#include "qom/object.h"
+#include "qapi/error.h"
+
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+#else
+#define EMSCRIPTEN_KEEPALIVE
+#endif
+
+/* Both powers of two: the ring index is free-running and masked on use. */
+#define BROWSER_IN_SIZE   1024
+#define BROWSER_OUT_SIZE  16384
+#define BROWSER_POLL_MS   20
+
+struct BrowserChardev {
+    Chardev parent;
+    QEMUTimer *timer;
+
+    /* Page -> QEMU. Written by JavaScript, read by browser_chr_drain(). */
+    uint8_t in_buf[BROWSER_IN_SIZE];
+    uint32_t in_head;
+    uint32_t in_tail;
+
+    /* QEMU -> page. Written by browser_chr_write(), read by JavaScript. */
+    uint8_t out_buf[BROWSER_OUT_SIZE];
+    uint32_t out_head;
+    uint32_t out_tail;
+};
+typedef struct BrowserChardev BrowserChardev;
+
+#define TYPE_CHARDEV_BROWSER "chardev-browser"
+DECLARE_INSTANCE_CHECKER(BrowserChardev, BROWSER_CHARDEV, TYPE_CHARDEV_BROWSER)
+
+/* Named slots the page can reach. Label comes from -chardev …,id=. */
+static BrowserChardev *browser_mon;
+static BrowserChardev *browser_gdb;
+
+/* Frontend -> page: output waiting to be read out of the heap. */
+static int browser_chr_write(Chardev *chr, const uint8_t *buf, int len)
+{
+    BrowserChardev *s = BROWSER_CHARDEV(chr);
+    uint32_t head = s->out_head;
+    uint32_t tail = qatomic_read(&s->out_tail);
+    int i;
+
+    for (i = 0; i < len; i++) {
+        /* Full: drop the byte rather than overwrite one not yet read. */
+        if (head - tail >= BROWSER_OUT_SIZE) {
+            break;
+        }
+        s->out_buf[head % BROWSER_OUT_SIZE] = buf[i];
+        head++;
+    }
+
+    /* Publish after the payload, so the reader never sees an index that
+     * outruns the bytes behind it.
+     */
+    smp_wmb();
+    qatomic_set(&s->out_head, head);
+    return len;
+}
+
+/* Page -> frontend, on QEMU's thread. */
+static void browser_chr_drain(void *opaque)
+{
+    BrowserChardev *s = opaque;
+    Chardev *chr = CHARDEV(s);
+    uint32_t head = qatomic_read(&s->in_head);
+    uint32_t tail = s->in_tail;
+
+    smp_rmb();
+
+    while (tail != head) {
+        uint8_t byte;
+        int can = qemu_chr_be_can_write(chr);
+
+        if (can <= 0) {
+            break; /* frontend is busy; the next tick tries again */
+        }
+        byte = s->in_buf[tail % BROWSER_IN_SIZE];
+        qemu_chr_be_write(chr, &byte, 1);
+        tail++;
+    }
+
+    qatomic_set(&s->in_tail, tail);
+    timer_mod(s->timer,
+              qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + BROWSER_POLL_MS);
+}
+
+static void browser_chr_open(Chardev *chr, ChardevBackend *backend,
+                             bool *be_opened, Error **errp)
+{
+    BrowserChardev *s = BROWSER_CHARDEV(chr);
+    const char *label = chr->label ? chr->label : "";
+
+    if (strcmp(label, "mon0") == 0) {
+        /* QMP needs OPENED immediately. */
+        *be_opened = true;
+        if (browser_mon != NULL && browser_mon != s) {
+            error_setg(errp, "browser chardev id=mon0 already claimed");
+            return;
+        }
+        browser_mon = s;
+    } else if (strcmp(label, "gdb0") == 0) {
+        /* Stay closed until qemu_browser_gdb_attach() — otherwise the
+         * gdbstub freezes the guest at boot waiting for a client that
+         * has not connected yet.
+         */
+        *be_opened = false;
+        if (browser_gdb != NULL && browser_gdb != s) {
+            error_setg(errp, "browser chardev id=gdb0 already claimed");
+            return;
+        }
+        browser_gdb = s;
+    } else {
+        /* Working chardev, but the page has no exports for this id. */
+        *be_opened = true;
+    }
+
+    s->timer = timer_new_ms(QEMU_CLOCK_REALTIME, browser_chr_drain, s);
+    timer_mod(s->timer,
+              qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + BROWSER_POLL_MS);
+}
+
+static void browser_chr_finalize(Object *obj)
+{
+    BrowserChardev *s = BROWSER_CHARDEV(obj);
+
+    if (s->timer) {
+        timer_free(s->timer);
+        s->timer = NULL;
+    }
+    if (browser_mon == s) {
+        browser_mon = NULL;
+    }
+    if (browser_gdb == s) {
+        browser_gdb = NULL;
+    }
+}
+
+/*
+ * Shared ring helpers. All run on the browser thread and touch nothing but
+ * the rings. Indices are free-running uint32 and wrap naturally.
+ */
+
+static int browser_feed(BrowserChardev *s, int value)
+{
+    uint32_t head, tail;
+
+    if (s == NULL) {
+        return -1;
+    }
+    head = s->in_head;
+    tail = qatomic_read(&s->in_tail);
+    if (head - tail >= BROWSER_IN_SIZE) {
+        return -1;
+    }
+    s->in_buf[head % BROWSER_IN_SIZE] = (uint8_t)value;
+    smp_wmb();
+    qatomic_set(&s->in_head, head + 1);
+    return 0;
+}
+
+static void *browser_ring(BrowserChardev *s)
+{
+    return s ? s->out_buf : NULL;
+}
+
+static int browser_ring_size(BrowserChardev *s)
+{
+    return s ? BROWSER_OUT_SIZE : 0;
+}
+
+static unsigned int browser_write_index(BrowserChardev *s)
+{
+    return s ? qatomic_read(&s->out_head) : 0;
+}
+
+static unsigned int browser_read_index(BrowserChardev *s)
+{
+    return s ? s->out_tail : 0;
+}
+
+static void browser_set_read_index(BrowserChardev *s, unsigned int value)
+{
+    if (s != NULL) {
+        qatomic_set(&s->out_tail, value);
+    }
+}
+
+EMSCRIPTEN_KEEPALIVE
+int qemu_browser_monitor_feed(int value)
+{
+    return browser_feed(browser_mon, value);
+}
+
+EMSCRIPTEN_KEEPALIVE
+void *qemu_browser_monitor_ring(void)
+{
+    return browser_ring(browser_mon);
+}
+
+EMSCRIPTEN_KEEPALIVE
+int qemu_browser_monitor_ring_size(void)
+{
+    return browser_ring_size(browser_mon);
+}
+
+EMSCRIPTEN_KEEPALIVE
+unsigned int qemu_browser_monitor_write_index(void)
+{
+    return browser_write_index(browser_mon);
+}
+
+EMSCRIPTEN_KEEPALIVE
+unsigned int qemu_browser_monitor_read_index(void)
+{
+    return browser_read_index(browser_mon);
+}
+
+EMSCRIPTEN_KEEPALIVE
+void qemu_browser_monitor_set_read_index(unsigned int value)
+{
+    browser_set_read_index(browser_mon, value);
+}
+
+EMSCRIPTEN_KEEPALIVE
+int qemu_browser_gdb_feed(int value)
+{
+    return browser_feed(browser_gdb, value);
+}
+
+EMSCRIPTEN_KEEPALIVE
+void *qemu_browser_gdb_ring(void)
+{
+    return browser_ring(browser_gdb);
+}
+
+EMSCRIPTEN_KEEPALIVE
+int qemu_browser_gdb_ring_size(void)
+{
+    return browser_ring_size(browser_gdb);
+}
+
+EMSCRIPTEN_KEEPALIVE
+unsigned int qemu_browser_gdb_write_index(void)
+{
+    return browser_write_index(browser_gdb);
+}
+
+EMSCRIPTEN_KEEPALIVE
+unsigned int qemu_browser_gdb_read_index(void)
+{
+    return browser_read_index(browser_gdb);
+}
+
+EMSCRIPTEN_KEEPALIVE
+void qemu_browser_gdb_set_read_index(unsigned int value)
+{
+    browser_set_read_index(browser_gdb, value);
+}
+
+EMSCRIPTEN_KEEPALIVE
+int qemu_browser_gdb_attach(void)
+{
+    Chardev *chr;
+
+    if (browser_gdb == NULL) {
+        return -1;
+    }
+    chr = CHARDEV(browser_gdb);
+    if (!chr->be_open) {
+        qemu_chr_be_event(chr, CHR_EVENT_OPENED);
+    }
+    return 0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+void qemu_browser_gdb_detach(void)
+{
+    Chardev *chr;
+
+    if (browser_gdb == NULL) {
+        return;
+    }
+    chr = CHARDEV(browser_gdb);
+    if (chr->be_open) {
+        qemu_chr_be_event(chr, CHR_EVENT_CLOSED);
+    }
+}
+
+static void char_browser_class_init(ObjectClass *oc, const void *data)
+{
+    ChardevClass *cc = CHARDEV_CLASS(oc);
+
+    cc->open = browser_chr_open;
+    cc->chr_write = browser_chr_write;
+}
+
+static const TypeInfo char_browser_type_info = {
+    .name = TYPE_CHARDEV_BROWSER,
+    .parent = TYPE_CHARDEV,
+    .instance_size = sizeof(BrowserChardev),
+    .instance_finalize = browser_chr_finalize,
+    .class_init = char_browser_class_init,
+};
+
+static void register_types(void)
+{
+    type_register_static(&char_browser_type_info);
+}
+
+type_init(register_types);
diff --git a/include/chardev/char-browser.h b/include/chardev/char-browser.h
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/include/chardev/char-browser.h
@@ -0,0 +1,43 @@
+/*
+ * Browser-backed character device: the entry points page JavaScript calls.
+ *
+ * Declared in a header only because QEMU builds with -Wmissing-prototypes;
+ * nothing inside QEMU calls any of these. See chardev/char-browser.c.
+ *
+ * Two named slots: mon0 (QMP) and gdb0 (gdbstub). gdb_attach/detach fire
+ * CHR_EVENT_OPENED/CLOSED so the stub does not freeze the guest at boot.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef CHARDEV_CHAR_BROWSER_H
+#define CHARDEV_CHAR_BROWSER_H
+
+/** Queue one byte from the page towards the monitor (id=mon0). */
+int qemu_browser_monitor_feed(int value);
+
+/** The monitor output ring: base pointer, size, and its free-running indices. */
+void *qemu_browser_monitor_ring(void);
+int qemu_browser_monitor_ring_size(void);
+unsigned int qemu_browser_monitor_write_index(void);
+unsigned int qemu_browser_monitor_read_index(void);
+void qemu_browser_monitor_set_read_index(unsigned int value);
+
+/** Queue one byte from the page towards the gdbstub (id=gdb0). */
+int qemu_browser_gdb_feed(int value);
+
+/** The gdbstub output ring: base pointer, size, and its free-running indices. */
+void *qemu_browser_gdb_ring(void);
+int qemu_browser_gdb_ring_size(void);
+unsigned int qemu_browser_gdb_write_index(void);
+unsigned int qemu_browser_gdb_read_index(void);
+void qemu_browser_gdb_set_read_index(unsigned int value);
+
+/**
+ * Tell the gdbstub a client is connected / gone.
+ * attach() returns 0 on success, -1 if gdb0 was never created.
+ */
+int qemu_browser_gdb_attach(void);
+void qemu_browser_gdb_detach(void);
+
+#endif /* CHARDEV_CHAR_BROWSER_H */
