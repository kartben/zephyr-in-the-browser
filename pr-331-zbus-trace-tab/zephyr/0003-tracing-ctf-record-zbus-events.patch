 subsys/tracing/ctf/ctf_top.h     | 115 +++++++++++++++++++++
 subsys/tracing/ctf/tracing_ctf.h |  62 +++++++++++
 subsys/tracing/ctf/tsdl/metadata | 170 +++++++++++++++++++++++++++++++
 4 files changed, 465 insertions(+)

