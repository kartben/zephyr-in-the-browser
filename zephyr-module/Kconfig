config QEMU_HOST_GPIO
	bool "QEMU host-backed GPIO"
	default y
	depends on DT_HAS_QEMU_HOST_GPIO_ENABLED
	depends on GPIO
	help
	  GPIO controller driver for the qemu-host-gpio MMIO device, whose input
	  pins are driven by the QEMU host and whose output pins are observed by
	  it. Under qemu-wasm that host is a browser, so a page can raise buttons
	  on the inputs and light indicators from the outputs the guest drives.

config QEMU_HOST_AUDIO
	bool "QEMU host-backed audio out (I2S)"
	default y
	depends on DT_HAS_QEMU_HOST_AUDIO_ENABLED
	depends on I2S
	help
	  Transmit-only I2S driver for the qemu-host-audio MMIO device: a PCM
	  ring the guest fills and the QEMU host drains. Under qemu-wasm that
	  host is a browser, so anything an application plays through Zephyr's
	  I2S API comes out of the speakers via the Web Audio API.

config QEMU_HOST_AUDIO_SHELL
	bool "hostaudio shell commands"
	default y
	depends on QEMU_HOST_AUDIO && SHELL
	help
	  `hostaudio info|beep|melody` commands, driving the audio bridge
	  through the I2S API, so it is demoable from the stock shell sample
	  without writing an application.

config QEMU_HOST_MIC
	bool "QEMU host-backed microphone (DMIC)"
	default y
	depends on DT_HAS_QEMU_HOST_MIC_ENABLED
	depends on AUDIO_DMIC
	help
	  DMIC driver for the qemu-host-mic MMIO device: a PCM ring the QEMU
	  host fills and the guest drains. Under qemu-wasm that host is a
	  browser capturing getUserMedia audio, so Zephyr's DMIC API records
	  from the user's real microphone.

# Vendored, not ours: these mirror the upstream names exactly so that the
# migration is a deletion once the drivers land in mainline. See
# drivers/vendor/VENDOR.md — CMakeLists.txt drops the vendored source the
# moment the Zephyr tree ships its own copy.
config GPIO_VIRTIO
	bool "VIRTIO GPIO driver"
	default y
	depends on DT_HAS_VIRTIO_GPIO_ENABLED
	select VIRTIO
	help
	  Enable driver for VIRTIO GPIO devices.

config I2C_VIRTIO
	bool "VIRTIO I2C adapter driver"
	default y
	depends on DT_HAS_VIRTIO_I2C_ENABLED
	select VIRTIO
	help
	  Enable driver for VIRTIO I2C adapter devices.

	  Every transfer is a round trip to the virtio device, so the I2C API
	  can only be used from a thread.

# Nested exactly as upstream's drivers/i2c/Kconfig.virtio nests it, so the whole
# block deletes cleanly.
if I2C_VIRTIO

config I2C_VIRTIO_MAX_MSGS
	int "Messages submitted per batch"
	default 8
	range 1 255
	help
	  How many messages of one i2c_transfer the driver queues before
	  notifying the device. A transfer longer than this is split into
	  several batches, which is correct but costs one extra round trip
	  apiece, so the default is set well above the two messages a register
	  read takes.

	  Each slot costs a handful of bytes of RAM, and sizes the request
	  virtqueue at three descriptors per message.

endif # I2C_VIRTIO

config SPI_VIRTIO
	bool "VIRTIO SPI controller driver"
	default y
	depends on DT_HAS_VIRTIO_SPI_ENABLED
	select VIRTIO
	help
	  Enable driver for the VIRTIO SPI controller device, giving access to
	  a SPI controller exposed by the host.

	  Every transfer is a round trip to the virtio device, so the SPI API
	  can only be used from a thread.

config VIRTIO_GPU_DISPLAY
	bool "VIRTIO GPU display"
	default y
	depends on DT_HAS_VIRTIO_GPU_ENABLED
	select VIRTIO
	help
	  Enable the VIRTIO GPU 2D display driver.

# Vendored from kartben/zephyr auxdisplay_shell_ — same symbol upstream will
# use under drivers/auxdisplay/Kconfig. CMakeLists.txt drops the vendored
# source once Zephyr ships drivers/auxdisplay/auxdisplay_shell.c.
config AUXDISPLAY_SHELL
	bool "Auxiliary display shell"
	depends on AUXDISPLAY && SHELL
	help
	  Enable the auxiliary display shell with related commands.

# Drop-in replacement for in-tree CONFIG_AUXDISPLAY_GPIO_7SEG. Upstream's
# k_timer expiry handler calls gpio_pin_set_dt() from ISR context, which breaks
# virtio,gpio (and any other sleeping GPIO backend). Force the in-tree driver
# off in conf/auxdisplay-shell.conf when enabling this.
config AUXDISPLAY_GPIO_7SEG_WQ
	bool "GPIO 7-segment display (workqueue multiplex)"
	default y
	depends on DT_HAS_GPIO_7_SEGMENT_ENABLED
	select GPIO
	help
	  Same gpio-7-segment auxdisplay as CONFIG_AUXDISPLAY_GPIO_7SEG, but the
	  digit multiplex runs on the system workqueue so GPIO updates happen in
	  thread context. Use this with virtio,gpio; keep the in-tree driver
	  disabled (CONFIG_AUXDISPLAY_GPIO_7SEG=n) to avoid linking both.

config VIRTIO_GPU_DISPLAY_QUEUE_SIZE
	int "VIRTIO GPU virtqueue size"
	depends on VIRTIO_GPU_DISPLAY
	default 16
	range 2 256
	help
	  Number of descriptors allocated for each VIRTIO GPU virtqueue. This
	  value must be a power of two.


# A prop, not a driver: it exists so system-managed device PM has something to
# suspend. Nothing in a browser_bridge build implements a PM action callback, so
# without this the suspend walk returns -ENOSYS for every device and honestly
# reports suspending none of them. See drivers/pm_demo_device.c.
config PM_DEMO_DEVICE
	bool "Power management demo device"
	default y
	depends on DT_HAS_ZEPHYR_PM_DEMO_DEVICE_ENABLED
	depends on PM_DEVICE
	help
	  Devices that implement nothing but PM_DEVICE_ACTION_SUSPEND and
	  PM_DEVICE_ACTION_RESUME, each burning the microseconds its node asks
	  for, so the PM core's device walk has measurable width in a trace.
