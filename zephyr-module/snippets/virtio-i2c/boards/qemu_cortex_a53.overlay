/*
 * Copyright (c) 2026
 * SPDX-License-Identifier: Apache-2.0
 *
 * Turn on the Cortex-A53's VIRTIO I2C adapter and describe the chips the
 * browser has on the bus. The node itself is declared (disabled) by the
 * browser_bridge shield, whose overlay documents the slot and the QEMU side.
 *
 * The chips are page-side models (src/virtio/devices/chips/), so this overlay
 * and src/virtio/index.ts have to agree on what is soldered where: devicetree
 * is static, and a node here whose address the page is not answering for will
 * simply fail to bind. That is not a bug to hide — a chip the page detaches
 * NAKs exactly like one that fell off the board, which makes a bus error a
 * thing this simulator can actually demonstrate.
 *
 * Snippet overlays are applied after the shield's, so virtio_i2c0 already
 * exists by the time this runs.
 */

&virtio_mmio4 {
	status = "okay";
};

&virtio_i2c0 {
	status = "okay";

	/*
	 * Matches createAt24({ address: 0x50 }) in src/virtio/index.ts. The
	 * page models one-byte word addressing, which is the AT24C02 part.
	 */
	eeprom0: eeprom@50 {
		compatible = "atmel,at24";
		reg = <0x50>;
		size = <256>;
		pagesize = <8>;
		address-width = <8>;
		timeout = <5>;
		status = "okay";
	};

	/*
	 * Matches createTmp112({ address: 0x48 }) in src/virtio/index.ts, whose
	 * temperature its sensor card drives directly. Zephyr's stock ti,tmp112
	 * binds to it and talks over the real bus — `sensor get tmp112@48` reads a
	 * value the page made up, through an unmodified in-tree driver.
	 */
	tmp112_0: tmp112@48 {
		compatible = "ti,tmp112";
		reg = <0x48>;
		status = "okay";
	};

	/*
	 * Matches createLm75({ address: 0x49 }) in src/virtio/index.ts — a
	 * second, simpler temperature part one strap along, so both share the
	 * bus. `sensor get lm75@49` reads it through Zephyr's stock driver.
	 */
	lm75_0: lm75@49 {
		compatible = "lm75";
		reg = <0x49>;
		status = "okay";
	};

	/*
	 * Matches createAdxl345({ address: 0x53 }) in src/virtio/index.ts: a
	 * 3-axis accelerometer whose card can follow the device's own tilt.
	 * `accel0` (below) points here, so the LVGL accelerometer_chart sample
	 * reads it unmodified; `sensor get adxl345@53` reads it from the shell.
	 */
	adxl345_0: adxl345@53 {
		compatible = "adi,adxl345";
		reg = <0x53>;
		status = "okay";
	};

	/*
	 * Matches createLsm6dso({ address: 0x6a }) in src/virtio/index.ts: a
	 * 6-axis IMU whose ODR the stock st,lsm6dso driver sets through sensor
	 * attributes. samples/sensor/lsm6dso finds it via DEVICE_DT_GET_ONE;
	 * `sensor get lsm6dso@6a` reads it from the shell. No irq-gpios — the
	 * browser bus has no INT line, so the sample runs in polling mode.
	 */
	lsm6dso_0: lsm6dso@6a {
		compatible = "st,lsm6dso";
		reg = <0x6a>;
		status = "okay";
	};

	/*
	 * Matches createSsd1306({ address: 0x3c }) in src/virtio/index.ts, whose
	 * GDDRAM the OLED panel paints onto a canvas. Declared here so it shows up
	 * in `i2c scan`, but it only becomes the display when the `oled` snippet
	 * repoints zephyr,display at it — the board is otherwise on ramfb.
	 *
	 * The timing and charge-pump properties are the datasheet's defaults; the
	 * page ignores them, but they are required by the binding and a real part
	 * would need them.
	 */
	ssd1306_0: ssd1306@3c {
		compatible = "solomon,ssd1306";
		reg = <0x3c>;
		width = <128>;
		height = <64>;
		segment-offset = <0>;
		page-offset = <0>;
		display-offset = <0>;
		multiplex-ratio = <63>;
		prechargep = <0x22>;
		segment-remap;
		com-invdir;
		status = "okay";
	};
};

/*
 * Point the generic accelerometer alias at the ADXL345 on this bus. It lives in
 * the snippet, not the shield, so a build without I2C never carries a dangling
 * accel0 — and a build with it (the LVGL accelerometer_chart) resolves
 * DEVICE_DT_GET(DT_ALIAS(accel0)) to a real, driver-bound node.
 */
/ {
	aliases {
		accel0 = &adxl345_0;
	};
};
