node_modules
dist
.DS_Store
*.local
.vite

# qemu-wasm artifacts are large prebuilt binaries; they are dropped in, not
# committed. See public/qemu/README.md.
public/qemu/*
!public/qemu/README.md

# Bumble wheel (fetched by tools/vendor-bumble.sh). Keep README + manifest.
public/vendor/bumble/*.whl

# mirrored Zephyr sample docs; regenerated by `npm run docs:fetch` (locally
# and in the pages.yml deploy workflow), not committed. See README.md.
public/docs/

# local build scratch for tools/*.sh
.qemu-wasm-build/
.zephyr-build*/

# release bundles produced by tools/package-emulator.sh. The emulator and the
# guest images are separate assets so either can be released without the other;
# qemu-wasm-artifacts.tar.gz is the pre-split name, still consumed by pages.yml
# for releases cut before the split.
qemu-wasm-emulator.tar.gz
zephyr-images.tar.gz
qemu-wasm-artifacts.tar.gz

# macOS AppleDouble sidecars from tar extracts
._*

# Python bytecode from tools/
__pycache__/
